ax_width":"narrow","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground-heading)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"accordion_ny8Fy4":{"type":"accordion","name":"t:names.accordion","settings":{"icon":"caret","dividers":true,"type_preset":"h5","inherit_color_scheme":true,"color_scheme":"","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"accordion_row_8aCLFQ":{"type":"_accordion-row","settings":{"heading":"Wat is de levertijd?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_j3mMrV":{"type":"text","settings":{"text":"<p>De levertijd verschilt per product en is afhankelijk van onder andere beschikbaarheid, leverancier en eventuele maatwerkspecificaties. Voor veel voorraadproducten geldt dat bestellingen die op werkdagen vóór 13:00 uur worden geplaatst, vaak snel kunnen worden verwerkt en geleverd. Dit verschilt echter per product. De meest actuele indicatie van de levertijd staat, waar van toepassing, op de productpagina. In sommige gevallen wordt de levertijd tijdens of na het plaatsen van de bestelling aanvullend bevestigd.<\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_j3mMrV"]},"accordion_row_Dee8gp":{"type":"_accordion-row","settings":{"headin