{"sections":{"custom_liquid_zyDnfD":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"{%- liquid\n  assign bc_label = page_title | default: 'Pagina'\n  assign bc_url = nil\n  assign bc_show_mid = false\n  assign bc_mid_label = nil\n  assign bc_mid_url = nil\n\n  if template.name == 'collection' and collection\n    assign bc_label = collection.title\n  elsif template.name == 'product' and product\n    assign bc_label = product.title\n    if collection\n      assign bc_show_mid = true\n      assign bc_mid_label = collection.title\n      assign bc_mid_url = collection.url\n    elsif product.collections.size > 0\n      assign bc_show_mid = true\n      assign bc_mid_label = product.collections.first.title\n      assign bc_mid_url = product.collections.first.url\n    endif\n  elsif template.name == 'page' and page\n    assign bc_label = page.title\n  elsif template.name == 'blog' and blog\n    assign bc_label = blog.title\n  elsif template.name == 'article' and article and blog\n    assign bc_show_mid = true\n    assign bc_mid_label = blog.title\n    assign bc_mid_url = blog.url\n    assign bc_label = article.title\n  elsif template.name == 'search'\n    assign bc_label = 'Search'\n  elsif template.name == 'cart'\n    assign bc_label = 'Cart'\n  endif\n-%}\n\n<div class=\"rt-bc-outer page-width\">\n  <nav class=\"rt-bc\" aria-label=\"Breadcrumb\">\n    <ol class=\"rt-bc__list\" role=\"list\">\n\n      <!-- Home icon -->\n      <li class=\"rt-bc__item\">\n        <a class=\"rt-bc__link rt-bc__home\" href=\"{{ routes.root_url }}\" aria-label=\"Home\">\n          <span class=\"rt-bc__home-ico\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" focusable=\"false\" aria-hidden=\"true\">\n              <path d=\"M3.012,10.981,3,11H5v9a1,1,0,0,0,1,1H18a1,1,0,0,0,1-1V11h2a1,1,0,0,1,.555-1.832l-9-6a1,1,0,0,0-1.11,0l-9,6a1,1,0,0,0-.277,1.387A.98.98,0,0,0,3.012,10.981ZM10,14a1,1,0,0,1,1-1h2a1,1,0,0,1,1,1v5H10Z\"><\/path>\n            <\/svg>\n          <\/span>\n        <\/a>\n      <\/li>\n\n      <li class=\"rt-bc__sep\" aria-hidden=\"true\">\/<\/li>\n\n      {%- if bc_show_mid and bc_mid_label and bc_mid_url -%}\n        <li class=\"rt-bc__item\">\n          <a class=\"rt-bc__link\" href=\"{{ bc_mid_url }}\">{{ bc_mid_label }}<\/a>\n        <\/li>\n        <li class=\"rt-bc__sep\" aria-hidden=\"true\">\/<\/li>\n      {%- endif -%}\n\n      <li class=\"rt-bc__item\">\n        <span class=\"rt-bc__current\" aria-current=\"page\">{{ bc_label }}<\/span>\n      <\/li>\n\n    <\/ol>\n  <\/nav>\n<\/div>\n\n<style>\n  .rt-bc-outer{\n    width: 100% !important;\n    max-width: var(--page-width, 1200px);\n    margin: 0 auto !important;\n    background: #EDF0F2;\n    padding: 12px 12px 12px 16px !important;\n    border-radius: 0 !important;\n    text-align: left !important;\n    justify-self: start !important;\n    align-self: start !important;\n    place-self: start !important;\n  }\n\n  .rt-bc{\n    margin: 0 !important;\n    padding: 0 !important;\n    width: 100% !important;\n    text-align: left !important;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 500;\n    line-height: 1.2;\n    color: #003878;\n  }\n\n  .rt-bc__list{\n    display: flex;\n    justify-content: flex-start !important;\n    align-items: center;\n    gap: 8px;\n    margin: 0 !important;\n    padding: 0 !important;\n    list-style: none !important;\n    width: 100% !important;\n    flex-wrap: wrap;\n  }\n\n  .rt-bc__link{\n    color: #003878;\n    text-decoration: none;\n    transition: color .15s ease, text-decoration-color .15s ease;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .rt-bc__link:hover{\n    color: #FF7300;\n    text-decoration: underline;\n    text-decoration-color: #FF7300;\n  }\n\n  .rt-bc__home-ico{\n    display: inline-flex;\n    line-height: 0;\n  }\n  .rt-bc__home-ico svg{\n    display: block;\n    width: 16px;\n    height: 16px;\n    fill: currentColor;\n  }\n\n  .rt-bc__sep{ color: #003878; }\n\n  .rt-bc__current{\n    color: #003878;\n    font-size: 14px;\n    font-weight: 500;\n  }\n\n  @media (max-width: 749px){\n    .rt-bc-outer{\n      width: 100vw !important;\n      max-width: none !important;\n      margin-left: calc(50% - 50vw) !important;\n      margin-right: calc(50% - 50vw) !important;\n      padding: 12px 10px 12px 12px !important;\n    }\n  }\n<\/style>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"section_iX7ehP":{"type":"section","blocks":{"text_Ak6Xnb":{"type":"text","name":"t:names.heading","settings":{"text":"<h1>{{ closest.page.title }}<\/h1>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h2","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground-heading)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_gQNai6":{"type":"text","name":"t:names.text","settings":{"text":"<p>Op deze pagina vindt u informatie over bestellen, levering, retourneren, garantie en betalingen.<br\/>Staat uw vraag er niet tussen? Neem dan contact met ons op via het contactformulier.<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_Ak6Xnb","text_gQNai6"],"name":"t:names.rich_text_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"fl