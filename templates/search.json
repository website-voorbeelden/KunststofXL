normal","alignment":"left","type_preset":"h5","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground-heading)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":4,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"custom_liquid_6RzDeY":{"type":"custom-liquid","name":"vooraad tijdelijk","settings":{"custom_liquid":"{%- liquid\n  assign p = closest.product | default: product | default: card_product | default: product_resource\n  assign variant = p.selected_or_first_available_variant\n\n  assign tiers = blank\n  assign max_bp = 0\n  assign is_price_on_request = false\n\n  if p != blank\n    assign mf = p.metafields.custom.volume_discounts\n    if mf != blank\n      assign v = mf.value\n      if v != blank and v.tiers != blank\n        assign tiers = v.tiers\n      else\n        assign s = v | default: mf | to_s\n        if s != blank\n          assign parsed = s | parse_json\n          if parsed != blank and parsed.tiers != blank\n            assign tiers = parsed.tiers\n          endif\n        endif\n      endif\n    endif\n\n    if tiers != blank\n      for t in tiers\n        assign d = t.discount | default: 0 | plus: 0\n        if d > 1\n          assign d = d | divided_by: 100.0\n        endif\n        assign bp = d | times: 10000 | round\n        if bp > 9900\n          assign bp = 9900\n        endif\n        if bp > max_bp\n          assign max_bp = bp\n        endif\n      endfor\n    endif\n\n    assign base_incl = p.price_min\n    assign factor_bp = 10000 | minus: max_bp\n    assign from_incl = base_incl | times: factor_bp | divided_by: 10000\n\n    if base_incl <= 2 or from_incl <= 2\n      assign is_price_on_request = true\n    endif\n  endif\n\n  assign status_text = 'Op voorraad'\n\n  if p == blank or variant == blank or is_price_on_request\n    assign status_text = 'Snelle afhandeling'\n  else\n    if variant.inventory_management == 'shopify'\n      if variant.inventory_quantity > 0\n        assign status_text = 'Op voorraad'\n      else\n        if variant.inventory_policy == 'continue'\n          assign status_text = 'Snelle afhandeling'\n        else\n          assign status_text = 'Beschikbaar op aanvraag'\n        endif\n      endif\n    else\n      assign status_text = 'Op voorraad'\n    endif\n  endif\n-%}\n\n<div class=\"stock-status\">\n  <svg class=\"stock-status__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 20 20\" fill=\"#74C200\" aria-hidden=\"true\">\n    <path fill-rule=\"evenodd\" d=\"M2.93 2.93a9.997 9.997 0 0 1 14.141 0 10 10 0 0 1 2.93 7.07 10.004 10.004 0 0 1-10 10A10.004 10.004 0 0 1 0 10a10 10 0 0 1 2.928-7.07Zm12.227 4.673A1.087 1.087 0 0 0 15.07 6.1a1.01 1.01 0 0 0-1.456.09l-4.516 5.415-2.752-2.801a1.01 1.01 0 0 0-1.46 0 1.087 1.087 0 0 0 0 1.504l3.44 3.546c.2.207.476.32.76.311a1.02 1.02 0 0 0 .742-.358l5.33-6.205Z\"><\/path>\n  <\/svg>\n\n  <span class=\"stock-status__text\">{{ status_text }}<\/span>\n<\/div>\n\n<style>\n  .stock-status {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 5px;\n    margin-bottom: 5px;\n  }\n\n  .stock-status__icon {\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n    fill: #74C200;\n  }\n\n  .stock-status__text {\n    font-size: 16px;\n    line-height: 1.2;\n    color: inherit;\n  }\n<\/style>"},"blocks":{}},"price_fYkUgG":{"type":"price","name":"t:names.product_price","settings":{"show_sale_price_first":true,"show_installments":false,"show_tax_info":false,"type_preset":"h6","width":"100%","alignment":"left","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","color":"var(--color-foreground)","padding-block-start":0,"padding-block-end":8,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"custom_liquid_bchd4A":{"type":"custom-liquid","name":"Grijze balk","settings":{"custom_liquid":"<div class=\"grijze-balk\"><\/div>\n\n<style>\n.card-wrapper,\n.card,\n.product-card{\n  position: relative;\n  padding-bottom: 12px; \/* ruimte voor de balk *\/\n}\n\n.grijze-balk{\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 5px;\n  background: #F6F8F9;\n  transition: background-color 0.01s ease;\n}\n\n.card-wrapper:hover .grijze-balk,\n.card:hover .grijze-balk,\n.product-card:hover .grijze-balk{\n  background: #E0E0E0 !important;\n}\n<\/style>"},"blocks":{}}},"block_order":["product_card_gallery_cFExAi","product_title_j7qXTx","custom_liquid_6RzDeY","price_fYkUgG","custom_liquid_bchd4A"]}},"settings":{"layout_type":"grid","product_card_size":"medium","mobile_product_card_size":"large","enable_infinite_scroll":true,"products_per_page":24,"product_grid_width":"centered","full_width_on_mobile":true,"columns_gap_horizontal":16,"columns_gap_vertical":24,"padding-inline-start":0,"padding-inline-end":0,"color_scheme":"scheme-4","padding-block-start":24,"padding-block-end":24}}},"order":["search","main"]}