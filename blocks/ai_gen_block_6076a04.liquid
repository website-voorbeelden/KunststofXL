      "id": "link_2_enabled",
      "label": "Enable link 2",
      "default": true
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Text",
      "default": "Klantenservice"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "URL"
    },
    {
      "type": "header",
      "content": "Utility link 3"
    },
    {
      "type": "checkbox",
      "id": "link_3_enabled",
      "label": "Enable link 3",
      "default": true
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Text",
      "default": "Over ons"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "URL"
    },
    {
      "type": "header",
      "content": "Utility links style"
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Link spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "link_text_size",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_text_weight",
      "label": "Text weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 800
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_text_hover_color",
      "label": "Hover color",
      "default": "#003878"
    }
  ],
  "presets": [
    {
      "name": "USP bar"
    }
  ]
}
{% endschema %}