{% liquid
  assign section_collections = section.settings.collection_list

  if section_collections != blank
    assign max_items = section_collections.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  endif
%}

{% if section_collections != blank %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      color-{{ section.settings.color_scheme }}
      section-resource-list
      spacing-style
      gap-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% render 'gap-style', value: section.settings.gap %}
    "
    data-testid="collection-list"
  >
    <div class="section-resource-list__content">
      {%- content_for 'blocks' -%}
    </div>

    {% capture list_items %}
      {% for collection in section_collections limit: max_items %}
        <div class="resource-list__item">
          {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
        </div>
        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endcapture %}

    {% liquid
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      carousel_ref: 'collectionList',
      slide_count: max_items,
      content_type: 'collections',
      test_id: 'collections-list-grid'
    %}
  </div>
{% endif %}

<style>
  {% if section.settings.show_full_image_with_whitespace %}
    #shopify-section-{{ section.id }} .collection-card__image {
      aspect-ratio: 1 / 1 !important;
      background: #ffffff !important;
      overflow: hidden !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    #shopify-section-{{ section.id }} .collection-card__image img,
    #shopify-section-{{ section.id }} .collection-card__image .image-block__image,
    #shopify-section-{{ section.id }} .collection-card__image picture img,
    #shopify-section-{{ section.id }} .collection-card__image media img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center center !important;
      display: block !important;
      background: #ffffff !important;
    }
  {% endif %}

  {% if section.settings.horizontal_cards %}
    #shopify-section-{{ section.id }} .collection-card__inner {
      display: grid !important;
      grid-template-columns: {{ section.settings.horizontal_image_size }}px minmax(0, 1fr) !important;
      align-items: center !important;
      gap: 14px !important;
    }

    #shopify-section-{{ section.id }} .collection-card__image {
      width: {{ section.settings.horizontal_image_size }}px !important;
      min-width: {{ section.settings.horizontal_image_size }}px !important;
      margin: 0 !important;
    }

    #shopify-section-{{ section.id }} .collection-card__image img,
    #shopify-section-{{ section.id }} .collection-card__image .image-block__image {
      width: 100% !important;
      display: block !important;
    }

    {% if section.settings.show_full_image_with_whitespace %}
      #shopify-section-{{ section.id }} .collection-card__image {
        aspect-ratio: 1 / 1 !important;
        background: #ffffff !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }

      #shopify-section-{{ section.id }} .collection-card__image img,
      #shopify-section-{{ section.id }} .collection-card__image .image-block__image,
      #shopify-section-{{ section.id }} .collection-card__image picture img,
      #shopify-section-{{ section.id }} .collection-card__image media img {
        width: 100% !important;
        height: 100% !important;
        object-fit: contain !important;
        object-position: center center !important;
        background: #ffffff !important;
      }
    {% else %}
      #shopify-section-{{ section.id }} .collection-card__image img,
      #shopify-section-{{ section.id }} .collection-card__image .image-block__image {
        height: auto !important;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .collection-card__content {
      display: flex !important;
      align-items: center !important;
      min-width: 0 !important;
      padding: 0 12px 0 0 !important;
    }

    #shopify-section-{{ section.id }} .collection-card__content .text-block,
    #shopify-section-{{ section.id }} .collection-card__content p {
      margin: 0 !important;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .collection-card__inner {
        grid-template-columns: {{ section.settings.horizontal_image_size_mobile }}px minmax(0, 1fr) !important;
        gap: 10px !important;
      }

      #shopify-section-{{ section.id }} .collection-card__image {
        width: {{ section.settings.horizontal_image_size_mobile }}px !important;
        min-width: {{ section.settings.horizontal_image_size_mobile }}px !important;
      }

      #shopify-section-{{ section.id }} .collection-card__content {
        padding-right: 8px !important;
      }
    }
  {% endif %}
</style>

