g {\n  display: block;\n\n  width: 19px;\n  height: 19px;\n\n  flex: 0 0 19px;\n\n  fill: currentColor;\n}\n\n\n\/* ==================================================\n   TABLET\n================================================== *\/\n\n@media screen and (max-width: 1000px) {\n\n  .bxl-service__inner {\n    grid-template-columns:\n      190px\n      minmax(0, 1fr);\n\n    column-gap: 25px;\n  }\n\n\n  .bxl-service__person {\n    width: 190px;\n  }\n\n\n  .bxl-service__person-image {\n    height: 195px;\n  }\n\n\n  .bxl-service__content {\n    gap: 20px;\n  }\n\n\n  .bxl-service__content h2 {\n    font-size: 30px;\n  }\n\n\n  .bxl-service__usps {\n    justify-content: flex-start !important;\n\n    gap: 11px 24px !important;\n  }\n\n}\n\n\n\/* ==================================================\n   MOBIEL\n\n   HIER VERANDERT NIKS:\n   - USP'S WEG\n   - GRIJS 60%\n   - KLANTENSERVICE BOVEN\n   - PERSOON ONDER\n================================================== *\/\n\n@media screen and (max-width: 600px) {\n\n  .bxl-service {\n    width: 100vw;\n    max-width: 100vw;\n\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n\n    overflow: visible;\n  }\n\n\n  .bxl-service::before {\n    display: block;\n\n    left: 0;\n    right: 0;\n\n    top: 60%;\n    bottom: 0;\n\n    width: 100vw;\n\n    transform: none;\n\n    background: var(--bxl-bg);\n  }\n\n\n  .bxl-service__inner {\n    width: calc(100% - 36px);\n\n    min-height: 0;\n\n    margin-left: auto;\n    margin-right: auto;\n\n    padding: 30px 0 0;\n\n    display: flex;\n\n    flex-direction: column;\n\n    align-items: stretch;\n\n    gap: 0;\n  }\n\n\n  \/* USP'S HELEMAAL WEG *\/\n\n  .bxl-service__usps {\n    display: none !important;\n  }\n\n\n  \/* KLANTENSERVICE *\/\n\n  .bxl-service__content {\n    order: 1;\n\n    width: 100%;\n\n    display: flex;\n\n    flex-direction: column;\n\n    align-items: center;\n\n    gap: 17px;\n\n    text-align: center;\n  }\n\n\n  .bxl-service__content h2 {