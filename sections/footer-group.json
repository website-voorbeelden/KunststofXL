n\n  position: relative;\n  width: 100%;\n  box-sizing: border-box;\n  overflow: visible;\n}\n\n\n\/* ==================================================\n   ACHTERGROND\n\n   DESKTOP = 50%\n================================================== *\/\n\n.bxl-service::before {\n  content: \"\";\n\n  position: absolute;\n  z-index: 0;\n\n  left: 50%;\n  top: 50%;\n  bottom: 0;\n\n  width: 100vw;\n\n  transform: translateX(-50%);\n\n  background: var(--bxl-bg);\n\n  pointer-events: none;\n}\n\n\n\/* ==================================================\n   DESKTOP LAYOUT\n\n   USP'S NU BOVEN\n   KLANTENSERVICE ONDER\n================================================== *\/\n\n.bxl-service__inner {\n  position: relative;\n  z-index: 1;\n\n  width: min(1280px, calc(100% - 48px));\n  min-height: 295px;\n\n  margin: 0 auto;\n  padding: 50px 0 27px;\n\n  box-sizing: border-box;\n\n  display: grid;\n\n  grid-template-columns:\n    230px\n    minmax(0, 1fr);\n\n  grid-template-rows:\n    max-content\n    max-content;\n\n  grid-template-areas:\n    \"person usps\"\n    \"person content\";\n\n  column-gap: 45px;\n\n  \/*\n    Ruimte tussen USP's en klantenservice.\n  *\/\n  row-gap: 18px;\n\n  align-content: end;\n}\n\n\n\/* ==================================================\n   PERSOON\n================================================== *\/\n\n.bxl-service__person {\n  position: absolute;\n\n  z-index: 2;\n\n  left: 0;\n  bottom: 0;\n\n  width: 230px;\n  height: 245px;\n\n  pointer-events: none;\n}\n\n\n.bxl-service__person-image {\n  position: absolute;\n\n  left: 0;\n  bottom: -27px;\n\n  display: block;\n\n  width: auto;\n  height: 220px;\n\n  max-width: none;\n\n  object-fit: contain;\n  object-position: left bottom;\n}\n\n\n\/* ==================================================\n   USP'S BOVENAAN\n================================================== *\/\n\n.bxl-service__usps {\n  grid-area: usps;\n\n  min-width: 0;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  display: flex !important;\n\n  flex-direction: row !important;\n\n  align-items: center !important;\n\n  justify-content: space-between !important;\n\n  flex-wrap: wrap !important;\n\n  gap: 10px 28px !important;\n}\n\n\n.bxl-service__usps .usp-item,\n.bxl-service__usps .usp-link {\n  display: inline-flex !important;\n\n  flex-direction: row !important;\n\n  align-items: center !important;\n\n  gap: 8px !important;\n\n  width: auto !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n\n.bxl-service__usps .usp-link {\n  color: inherit;\n  text-decoration: none;\n}\n\n\n\/* ==================================================\n   GROENE VINKJES\n================================================== *\/\n\n.bxl-service__usps .usp-check {\n  display: inline-flex !important;\n\n  align-items: center !important;\n  justify-content: center !important;\n\n  width: 14px !important;\n  height: 14px !important;\n\n  min-width: 14px !important;\n  max-width: 14px !important;\n\n  min-height: 14px !important;\n  max-height: 14px !important;\n\n  flex: 0 0 14px !important;\n\n  margin: 0 !important;\n  padding: 0 !important;\n\n  color: var(--bxl-green) !important;\n}\n\n\n.bxl-service__usps .usp-check svg {\n  display: block !important;\n\n  width: 14px !important;\n  height: 14px !important;\n\n  min-width: 14px !important;\n  max-width: 14px !important;\n\n  min-height: 14px !important;\n  max-height: 14px !important;\n\n  fill: var(--bxl-green) !important;\n}\n\n\n.bxl-service__usps .usp-check svg path {\n  fill: var(--bxl-green) !important;\n}\n\n\n\/* ==================================================\n   KLANTENSERVICE ONDER USP'S\n================================================== *\/\n\n.bxl-service__content {\n  grid-area: content;\n\n  min-width: 0;\n\n  display: flex;\n\n  align-items: center;\n\n  justify-content: space-between;\n\n  gap: 35px;\n\n  margin: 0;\n  padding: 0;\n}\n\n\n.bxl-service__content h2 {\n  flex: 0 0 auto;\n\n  margin: 0 !important;\n\n  color: