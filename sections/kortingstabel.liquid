<style>
/* =========================
   Volume discounts – cleaned & stable (no duplicates)
   Brand colors:
   Navy  #003878
   Gold  #E2BA10
   Green #74C200
   ========================= */

/* Wrapper */
#discount-table-section{
  margin-top: 14px;
  width: 100%;
}

/* The table itself */
#discount-table-section .discount-table{
  /* ✅ Fix “vage breedte”: maak tabel altijd 100% van z’n container
     en stuur de “look” met max-width i.p.v. % widths */
  width: 100%;
  max-width: 650px;          /* pas aan als je ‘m smaller/breder wilt */
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #d9d9d9;
  background: #fff;
  margin-top: 12px;

  /* voorkomt rare kolom-breedtes door lange content */
  table-layout: fixed;
}

/* Mobile: gewoon full width */
@media (max-width: 767px){
  #discount-table-section .discount-table{
    max-width: 100%;
  }
}

/* Head cells */
#discount-table-section .discount-table thead th{
  background: #fff;
  color: #003878;
  font-weight: 700;
  padding: 10px 10px;
  text-align: center;
  vertical-align: middle;
  border-bottom: 1px solid #d9d9d9;
  font-size: 14px;
}

/* Subtext in head */
#discount-table-section .discount-table thead th .subtext{
  display: block;
  margin-top: 2px;
  font-size: 10px;
  font-weight: 500;
  color: rgba(0,0,0,.55);
}

/* Body cells */
#discount-table-section .discount-table td{
  padding: 10px 10px;
  text-align: center;
  vertical-align: middle;
  border-bottom: 1px solid #e9e9e9;
  font-size: 14px;
  color: #222;

  /* ✅ Fix “vage breedte”: NIET width:100% op td/th zetten */
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* No bottom border on last row */
#discount-table-section .discount-table tbody tr:last-child td{
  border-bottom: none;
}

/* Zebra */
#discount-table-section .discount-table tbody tr:nth-child(even){
  background: #f7f8fa;
}
#discount-table-section .discount-table tbody tr:nth-child(odd){
  background: #fff;
}

/* Clickable tiers */
#discount-table-section .discount-table tr[data-min-qty]{
  cursor: pointer;
}

/* Discount column: last column green */
#discount-table-section .discount-table tbody td:last-child{
  color: #74C200;
  font-weight: 800;
}

/* Base row: dash muted */
#discount-table-section .discount-table tbody tr[data-min-qty="1"] td:last-child{
  color: rgba(0,0,0,.55);
  font-weight: 600;
}

/* Active tier: gold tint + green outline */
#discount-table-section .discount-table tr.active-tier{
  background: rgba(226,186,16,.16) !important; /* #E2BA10 tint */
  outline: 2px solid #74C200;
  outline-offset: -2px;
}
#discount-table-section .discount-table tr.active-tier td{
  font-weight: 800;
}
#discount-table-section .discount-table tr.active-tier td:last-child{
  font-size: 1.05em;
}

/* Rounded corners */
#discount-table-section .discount-table thead th:first-child{ border-top-left-radius: 12px; }
#discount-table-section .discount-table thead th:last-child{  border-top-right-radius: 12px; }

/* =========================
   Price totals under price (classes created by JS)
   ========================= */

/* Scope price layout fixes to product info area (Dawn-safe) */
.product__info-container .price{
  margin-top: 0 !important;
  padding-top: 0 !important;
  line-height: 1.1 !important;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* Excl price line */
.price-item--excl{
  margin-top: 8px;
  font-size: 20px;
  font-weight: 800;
  color: #003878;
  line-height: 1.1;
}
.price-item--excl-text{
  font-size: 20px;
  font-weight: 800;
  color: #003878;
}

/* Incl price line */
.price-item--incl{
  margin-top: 4px;
  font-size: 12px;
  font-weight: 500;
  color: rgba(0,0,0,.60);
  line-height: 1.2;
}
.price-item--incl-text{
  font-size: 12px;
  font-weight: 500;
  color: rgba(0,0,0,.60);
}

/* Savings */
.savings-item{
  margin-top: 6px;
  color: #74C200 !important;
  font-size: 13px;
  font-weight: 800;
}
</style>
