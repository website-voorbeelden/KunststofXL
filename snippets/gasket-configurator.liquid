{% comment %} PVC plate configurator concept — reference-led, intentionally compact {% endcomment %}
{{ 'plate-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'plate-configurator.js' | asset_url }}" defer></script>

{% liquid
  assign pc_variant = product.selected_or_first_available_variant
  assign pc_id = 'plate-configurator-' | append: product.id
  assign pc_base_price = pc_variant.price | default: 1000
%}

<section
  id="{{ pc_id }}"
  class="plate-configurator pc-page"
  data-plate-configurator
  data-base-price="{{ pc_base_price }}"
  data-min-width="2"
  data-min-height="2"
  data-max-width="305"
  data-max-height="155"
  data-locale="{{ request.locale.iso_code | default: 'nl-NL' }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
  <div class="pc-page__inner">
    <div class="pc-preview">
      <div class="pc-canvas">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 1400 | image_tag: class: 'pc-product-image', alt: product.title, loading: 'eager' }}
        {% else %}
          <div class="pc-product-image pc-product-image--empty">Geen productafbeelding</div>
        {% endif %}

        <svg class="pc-svg" viewBox="0 0 700 500" role="img" aria-label="Voorbeeld van jouw plaat met maatvoering">
          <defs>
            <marker id="{{ pc_id }}-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 10 5 0 10z"></path>
            </marker>
          </defs>

          <g class="pc-object">
            <path class="pc-shape" d="M 220 95 H 480 V 355 H 220 Z"></path>
            <text class="pc-letter-shape" text-anchor="middle" dominant-baseline="middle" hidden>A</text>
            <g class="pc-cutout-layer" hidden>
              <circle class="pc-cutout-circle"></circle>
            </g>
            <g class="pc-holes"></g>
          </g>

          <g class="pc-dimensions">
            <line class="pc-guide pc-w-ext-a" x1="220" y1="359" x2="220" y2="410"></line>
            <line class="pc-guide pc-w-ext-b" x1="480" y1="359" x2="480" y2="410"></line>
            <line class="pc-dim pc-dim-w" x1="220" y1="403" x2="480" y2="403" marker-start="url(#{{ pc_id }}-arrow)" marker-end="url(#{{ pc_id }}-arrow)"></line>
            <rect class="pc-label-bg pc-label-w-bg" x="318" y="392" width="64" height="22" rx="3"></rect>
            <text class="pc-dim-text pc-label-w" x="350" y="403" text-anchor="middle" dominant-baseline="middle">10 cm</text>

            <line class="pc-guide pc-h-ext-a" x1="216" y1="95" x2="163" y2="95"></line>
            <line class="pc-guide pc-h-ext-b" x1="216" y1="355" x2="163" y2="355"></line>
            <line class="pc-dim pc-dim-h" x1="170" y1="95" x2="170" y2="355" marker-start="url(#{{ pc_id }}-arrow)" marker-end="url(#{{ pc_id }}-arrow)"></line>
            <rect class="pc-label-bg pc-label-h-bg" x="138" y="214" width="64" height="22" rx="3"></rect>
            <text class="pc-dim-text pc-label-h" x="170" y="225" text-anchor="middle" dominant-baseline="middle">10 cm</text>
          </g>
        </svg>

        <div class="pc-view-toggle" role="tablist" aria-label="Voorbeeldweergave">
          <button type="button" data-pc-view="image" role="tab" aria-selected="false">
            <span class="pc-view-thumb" aria-hidden="true"></span>
            Afbeelding
          </button>
          <button type="button" data-pc-view="dimensions" role="tab" aria-selected="true">Afmetingen</button>
        </div>
      </div>
    </div>

    <div class="pc-config">
      <header class="pc-product-head">
        <h1>{% if product.title contains 'grijs' or product.title contains 'Grijs' %}{{ product.title }}{% else %}{{ product.title }} grijs{% endif %}</h1>
        <div class="pc-rating" aria-label="Conceptbeoordeling">★★★★★ <span>7 reviews</span></div>
        <div class="pc-product-head__bottom">
          <div class="pc-start-price"><span data-pc-price>{{ pc_base_price | money }}</span> <small>incl. btw</small></div>
          <button type="button" class="pc-sample" data-pc-sample>◇ Bestel een sample</button>
        </div>
      </header>

      <div class="pc-accordions">
        <details class="pc-accordion" open>
          <summary>
            <span class="pc-status pc-status--done">✓</span>
            <span><strong>Afmetingen</strong><small data-pc-shape-summary>Rechthoek · 10 × 10 cm</small></span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="pc-accordion__body">
            <div class="pc-main-shape-tabs" role="tablist" aria-label="Vormmethode">
              <button type="button" data-pc-main-shape="rectangle" role="tab" aria-selected="true">
                <svg viewBox="0 0 42 34" aria-hidden="true"><rect x="8" y="8" width="26" height="18"/></svg>
                Rechthoek
              </button>
              <button type="button" data-pc-main-shape="picker" role="tab" aria-selected="false" aria-controls="{{ pc_id }}-picker-panel" aria-expanded="false">
                <svg viewBox="0 0 42 34" aria-hidden="true"><circle cx="13" cy="20" r="6"/><rect x="22" y="7" width="12" height="12" rx="4"/></svg>
                Vormkiezer
              </button>
              <button type="button" data-pc-main-shape="upload" role="tab" aria-selected="false" aria-controls="{{ pc_id }}-upload-panel" aria-expanded="false">
                <svg viewBox="0 0 42 34" aria-hidden="true"><path d="M9 26V8h16l8 8v10z"/><path d="M25 8v8h8M16 21h10M21 16v10"/></svg>
                Vorm upload
              </button>
            </div>

            <div class="pc-picker-panel" id="{{ pc_id }}-picker-panel" data-pc-picker-panel role="tabpanel" hidden>
              <p>Kies een eenvoudige vorm</p>
              <div class="pc-picker-options">
                <button type="button" data-pc-shape="rounded" aria-pressed="false">
                  <svg viewBox="0 0 48 38" aria-hidden="true"><rect x="5" y="9" width="38" height="20" rx="6"/></svg>
                  <span>Rechthoek met radius</span>
                </button>
                <button type="button" data-pc-shape="circle" aria-pressed="false">
                  <svg viewBox="0 0 48 38" aria-hidden="true"><circle cx="24" cy="19" r="13"/></svg>
                  <span>Cirkel</span>
                </button>
                <button type="button" data-pc-shape="letter" aria-pressed="false">
                  <svg viewBox="0 0 48 38" aria-hidden="true"><text x="24" y="28" text-anchor="middle">A</text></svg>
                  <span>Letters</span>
                </button>
                <button type="button" data-pc-open-upload aria-pressed="false">
                  <svg class="pc-custom-star" viewBox="0 0 48 38" aria-hidden="true"><path d="m24 5 4.2 8.6 9.5 1.4-6.9 6.7 1.6 9.4-8.4-4.4-8.4 4.4 1.6-9.4-6.9-6.7 9.5-1.4z"/></svg>
                  <span>Custom vorm</span>
                </button>
              </div>
            </div>

            <div class="pc-upload-panel" id="{{ pc_id }}-upload-panel" data-pc-upload-panel role="tabpanel" hidden>
              <div class="pc-upload-panel__icon" aria-hidden="true">
                <svg viewBox="0 0 32 32"><path d="M6 26V6h13l7 7v13z"/><path d="M19 6v7h7M16 22V14M12.5 17.5 16 14l3.5 3.5"/></svg>
              </div>
              <div class="pc-upload-panel__copy">
                <strong>Upload je eigen vorm</strong>
                <p>Voeg een afbeelding of schets toe. Voor deze conceptversie gebruiken we het bestand als visueel voorbeeld.</p>
              </div>
              <button type="button" class="pc-upload-button" data-pc-upload-trigger>Bestand uploaden</button>
              <input data-pc-upload type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden>
              <p class="pc-upload-result" data-pc-upload-result hidden></p>
            </div>

            <div class="pc-letter-settings" data-pc-letter-settings hidden>
              <div class="pc-letter-settings__mode">
                <span>Maat bepalen op</span>
                <div role="radiogroup" aria-label="Maat van de letters bepalen op">
                  <button type="button" data-pc-letter-size-mode="height" aria-pressed="true">Hoogte</button>
                  <button type="button" data-pc-letter-size-mode="width" aria-pressed="false">Breedte</button>
                </div>
              </div>
              <label>
                <span>Lettertype</span>
                <select data-pc-letter-font aria-label="Lettertype">
                  <option value="Arial, sans-serif">Arial</option>
                  <option value="'Trebuchet MS', sans-serif">Trebuchet</option>
                  <option value="Georgia, serif">Georgia</option>
                  <option value="Impact, sans-serif">Impact</option>
                </select>
              </label>
            </div>

            <div class="pc-dimension-fields">
              <label data-pc-width-field>
                <span data-pc-width-label>Breedte</span>
                <small data-pc-width-max id="{{ pc_id }}-width-help">Min. 2 cm · max. 305 cm</small>
                <div><input data-pc-width type="number" value="10" min="2" max="305" step="0.1" inputmode="decimal" aria-describedby="{{ pc_id }}-width-help {{ pc_id }}-width-error" aria-invalid="false"><b>cm</b></div>
                <small class="pc-field-error" id="{{ pc_id }}-width-error" data-pc-width-error role="alert" hidden></small>
              </label>
              <label data-pc-height-field>
                <span data-pc-height-label>Hoogte</span>
                <small id="{{ pc_id }}-height-help" data-pc-height-limits>Min. 2 cm · max. 155 cm</small>
                <div><input data-pc-height type="number" value="10" min="2" max="155" step="0.1" inputmode="decimal" aria-describedby="{{ pc_id }}-height-help {{ pc_id }}-height-error" aria-invalid="false"><b>cm</b></div>
                <small class="pc-field-error" id="{{ pc_id }}-height-error" data-pc-height-error role="alert" hidden></small>
              </label>
              <label data-pc-letter-field hidden>
                <span>Letters</span>
                <small>Vast lettertype</small>
                <div><input data-pc-letter type="text" value="A" maxlength="8" aria-label="Letters"><b>ABC</b></div>
              </label>
            </div>

            <label class="pc-toggle pc-rounded-toggle" data-pc-rounded-option>
              <input type="checkbox" data-pc-rounded>
              <span aria-hidden="true"></span>
              Afgeronde hoeken
            </label>

            <div class="pc-inline-fields pc-inline-fields--single pc-radius-panel" data-pc-radius-field hidden>
              <label>
                <span>Hoekradius</span>
                <small data-pc-radius-max>Max. 5 cm</small>
                <div><input data-pc-radius type="number" value="1" min="0.1" max="5" step="0.1" inputmode="decimal"><b>cm</b></div>
              </label>
            </div>
          </div>
        </details>

        <details class="pc-accordion">
          <summary>
            <span class="pc-status pc-status--done">✓</span>
            <span><strong>Dikte</strong><small data-pc-thickness-summary>2 mm</small></span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="pc-accordion__body">
            <p class="pc-control-label">Bepaal de dikte (mm)</p>
            <div class="pc-thickness-grid" role="radiogroup" aria-label="Dikte">
              <button type="button" data-pc-thickness="2" aria-pressed="true">2</button>
              <button type="button" data-pc-thickness="3" aria-pressed="false">3</button>
              <button type="button" data-pc-thickness="4" aria-pressed="false">4</button>
              <button type="button" data-pc-thickness="5" aria-pressed="false">5</button>
              <button type="button" data-pc-thickness="6" aria-pressed="false">6</button>
              <button type="button" data-pc-thickness="8" aria-pressed="false">8</button>
              <button type="button" data-pc-thickness="10" aria-pressed="false">10</button>
              <button type="button" data-pc-thickness="13" aria-pressed="false">13</button>
              <button type="button" data-pc-thickness="19" aria-pressed="false">19</button>
            </div>
          </div>
        </details>

        <details class="pc-accordion">
          <summary>
            <span class="pc-status" data-pc-holes-status></span>
            <span><strong>Boorgaten</strong><small data-pc-holes-summary>Geen</small></span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="pc-accordion__body">
            <label class="pc-toggle">
              <input type="checkbox" data-pc-holes>
              <span></span>
              Vier hoekgaten tonen
            </label>
            <div class="pc-inline-fields pc-inline-fields--single" data-pc-holes-fields hidden>
              <label>Diameter boorgat<div><input data-pc-hole-diameter type="number" value="8" min="3" max="30" step="0.1"><b>mm</b></div></label>
            </div>
          </div>
        </details>

        <details class="pc-accordion">
          <summary>
            <span class="pc-status" data-pc-cutout-status></span>
            <span><strong>Uitsnede</strong><small data-pc-cutout-summary>Geen</small></span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="pc-accordion__body">
            <label class="pc-toggle">
              <input type="checkbox" data-pc-cutout>
              <span></span>
              Centrale ronde uitsnede tonen
            </label>
            <div class="pc-inline-fields pc-inline-fields--single" data-pc-cutout-fields hidden>
              <label>Diameter uitsnede<div><input data-pc-cutout-size type="number" value="3" min="1" max="50" step="0.1"><b>cm</b></div></label>
            </div>
          </div>
        </details>

        <details class="pc-accordion">
          <summary>
            <span class="pc-status pc-status--done">✓</span>
            <span><strong>Randafwerking</strong><small data-pc-finish-summary>Gezaagd</small></span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="pc-accordion__body pc-finish-grid">
            <button type="button" data-pc-finish="gezaagd" aria-pressed="true"><span>Gezaagd</span><small>Gratis</small></button>
            <button type="button" data-pc-finish="gefreesd" aria-pressed="false"><span>Gefreesd</span><small>Strakke rand</small></button>
          </div>
        </details>
      </div>

      <details class="pc-price-details">
        <summary>
          <span class="pc-price-details__heading">
            <span class="pc-price-details__icon" aria-hidden="true">€</span>
            <span><strong>Prijsopbouw</strong><small>Bekijk wat er in de prijs zit</small></span>
          </span>
          <span class="pc-price-details__amount"><strong data-pc-price>{{ pc_base_price | money }}</strong><i aria-hidden="true"></i></span>
        </summary>
        <div class="pc-price-details__body">
          <div>
            <span><strong>Plaat en dikte</strong><small>PVC grijs, op maat gezaagd</small></span>
            <b data-pc-breakdown-material>{{ pc_base_price | money }}</b>
          </div>
          <div>
            <span><strong>Vormbewerking</strong><small>De gekozen buitenvorm</small></span>
            <b data-pc-breakdown-shape>{{ 0 | money }}</b>
          </div>
          <div>
            <span><strong>Extra bewerkingen</strong><small>Boorgaten, uitsnede en randafwerking</small></span>
            <b data-pc-breakdown-extras>{{ 0 | money }}</b>
          </div>
          <div class="pc-price-details__total">
            <span><strong>Totaal per plaat</strong><small>Inclusief btw</small></span>
            <b data-pc-breakdown-total>{{ pc_base_price | money }}</b>
          </div>
        </div>
      </details>

      <section class="pc-order-box" aria-label="Bestelling afronden">
        <div class="pc-order-box__availability">
          <strong><span aria-hidden="true"></span> Op voorraad</strong>
          <span>Verwachte levering <b>binnen 1–3 werkdagen</b></span>
        </div>
        <div class="pc-order-box__selection">
          <span>Jouw plaat</span>
          <strong data-pc-summary>10 × 10 cm · 2 mm</strong>
        </div>
        <div class="pc-order-box__checkout">
          <div class="pc-total">
            <span>Totaal</span>
            <strong data-pc-price>{{ pc_base_price | money }}</strong>
            <small>incl. btw</small>
          </div>
          <div class="pc-quantity-field">
            <span>Aantal</span>
            <div class="pc-quantity">
              <button type="button" data-pc-minus aria-label="Aantal verlagen">−</button>
              <span data-pc-quantity>1</span>
              <button type="button" data-pc-plus aria-label="Aantal verhogen">＋</button>
            </div>
          </div>
          <button type="button" class="pc-cart" data-pc-cart>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l1.7 10.1a2 2 0 0 0 2 1.7h7.8a2 2 0 0 0 1.9-1.5L20 8H6.1M9.5 20a.8.8 0 1 1-1.6 0 .8.8 0 0 1 1.6 0Zm8 0a.8.8 0 1 1-1.6 0 .8.8 0 0 1 1.6 0Z"/></svg>
            <span>In winkelmand</span>
          </button>
        </div>
        <div class="pc-order-box__assurance">
          <span>✓ Veilig betalen</span>
          <span>✓ Op maat gemaakt in Nederland</span>
        </div>
      </section>
    </div>
  </div>

  <div class="pc-product-content">
    <section class="pc-machining-card" aria-labelledby="{{ pc_id }}-machining-title">
      <header>
        <div>
          <div class="pc-content-kicker">Bewerkingsmogelijkheden</div>
          <h2 id="{{ pc_id }}-machining-title">Wat kan met dit materiaal?</h2>
        </div>
      </header>

      <div class="pc-machining-columns">
        <div class="pc-machining-group pc-machining-group--yes">
          <h3><span aria-hidden="true">✓</span> Goed mogelijk</h3>
          <ul>
            <li>
              <span class="pc-process-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 17 17 4l3 3L7 20H4zM14 7l3 3M9 12l3 3"/></svg></span>
              <span><strong>Zagen</strong></span>
            </li>
            <li>
              <span class="pc-process-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/></svg></span>
              <span><strong>Boren</strong></span>
            </li>
            <li>
              <span class="pc-process-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h14v14H5zM8 8h8v8H8z"/></svg></span>
              <span><strong>Frezen</strong></span>
            </li>
            <li>
              <span class="pc-process-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m7 15 8-8 3 3-8 8H7zM5 19h14"/></svg></span>
              <span><strong>Lijmen</strong></span>
            </li>
          </ul>
        </div>

        <div class="pc-machining-group pc-machining-group--no">
          <h3><span aria-hidden="true">×</span> Niet geschikt</h3>
          <ul>
            <li>
              <span class="pc-process-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19"/></svg></span>
              <span><strong>Lasersnijden</strong></span>
            </li>
            <li>
              <span class="pc-process-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 16c5 0 5-8 10-8h6M17 5l3 3-3 3"/></svg></span>
              <span><strong>Koud buigen</strong></span>
            </li>
            <li>
              <span class="pc-process-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v9M9 7l3-3 3 3M6 18h12"/></svg></span>
              <span><strong>Hoge hitte</strong></span>
            </li>
          </ul>
        </div>
      </div>
    </section>
    <section class="pc-description-card" aria-label="Productomschrijving">
      <div class="pc-description-copy rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>Voor dit product is nog geen omschrijving ingevuld in Shopify.</p>
        {% endif %}
      </div>
    </section>

    {% assign pc_featured_collection = collections['kunststof-platen'] %}
    {% if pc_featured_collection != blank and pc_featured_collection.products_count > 0 %}
      <section class="pc-featured-collection" aria-labelledby="{{ pc_id }}-collection-title">
        <header>
          <div>
            <div class="pc-content-kicker">Uitgelichte collectie</div>
            <h2 id="{{ pc_id }}-collection-title">{{ pc_featured_collection.title }}</h2>
          </div>
          <a href="{{ pc_featured_collection.url }}">
            Bekijk alle platen
            <span aria-hidden="true">→</span>
          </a>
        </header>

        <div class="pc-featured-products">
          {% for pc_product in pc_featured_collection.products limit: 4 %}
            {% assign pc_product_image_alt = pc_product.featured_image.alt | default: pc_product.title %}
            <a class="pc-featured-product" href="{{ pc_product.url }}">
              <div class="pc-featured-product__media">
                {% if pc_product.featured_image %}
                  {{
                    pc_product.featured_image
                    | image_url: width: 640
                    | image_tag:
                      loading: 'lazy',
                      widths: '220, 320, 480, 640',
                      sizes: '(max-width: 560px) 46vw, (max-width: 900px) 32vw, 230px',
                      alt: pc_product_image_alt
                  }}
                {% else %}
                  <div class="pc-featured-product__placeholder" aria-hidden="true">
                    <svg viewBox="0 0 48 48"><rect x="8" y="11" width="32" height="26" rx="2"/><path d="m12 32 9-9 7 7 5-5 4 4"/></svg>
                  </div>
                {% endif %}
                {% if pc_product.available %}
                  <span class="pc-featured-product__stock">Op voorraad</span>
                {% endif %}
              </div>
              <div class="pc-featured-product__content">
                <h3>{{ pc_product.title }}</h3>
                <div class="pc-featured-product__price">
                  {% if pc_product.price_varies %}<small>Vanaf</small>{% endif %}
                  <strong>{{ pc_product.price_min | money }}</strong>
                  {% if pc_product.compare_at_price_max > pc_product.price_min %}
                    <s>{{ pc_product.compare_at_price_max | money }}</s>
                  {% endif %}
                </div>
                <span class="pc-featured-product__link">Bekijk product <i aria-hidden="true">→</i></span>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>

  <div class="pc-toast" data-pc-toast role="status" aria-live="polite" hidden></div>
</section>
