{% comment %} Full-width plate configurator concept {% endcomment %}
{{ 'plate-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'plate-configurator.js' | asset_url }}" defer></script>
{% liquid
  assign pc_variant = product.selected_or_first_available_variant
  assign pc_id = 'plate-configurator-' | append: product.id
  assign pc_sheet_width = product.metafields.custom.max_breedte.value | default: 3050
  assign pc_sheet_height = product.metafields.custom.max_hoogte.value | default: 1550
%}
<section id="{{ pc_id }}" class="plate-configurator pc-page" data-plate-configurator data-base-price="{{ pc_variant.price }}" data-sheet-width="{{ pc_sheet_width }}" data-sheet-height="{{ pc_sheet_height }}" data-locale="{{ request.locale.iso_code | default: 'nl-NL' }}" data-currency="{{ cart.currency.iso_code | default: shop.currency }}">
  <div class="pc-page__inner">
    <div class="pc-visual">
      <div class="pc-canvas">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'pc-image', alt: product.title }}
        {% endif %}
        <svg class="pc-svg" viewBox="0 0 640 430" role="img" aria-label="Voorbeeld van jouw plaat">
          <defs><marker id="{{ pc_id }}-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#2583a5"/></marker></defs>
          <path class="pc-shape"></path><rect class="pc-cutout" hidden></rect><g class="pc-holes"></g>
          <g class="pc-dimensions">
            <line class="pc-dim pc-ext pc-w-ext-a"></line><line class="pc-dim pc-ext pc-w-ext-b"></line>
            <line class="pc-dim pc-dim-w" marker-start="url(#{{ pc_id }}-arrow)" marker-end="url(#{{ pc_id }}-arrow)"></line>
            <text class="pc-dim-text pc-label-w" text-anchor="middle"></text>
            <line class="pc-dim pc-ext pc-h-ext-a"></line><line class="pc-dim pc-ext pc-h-ext-b"></line>
            <line class="pc-dim pc-dim-h" marker-start="url(#{{ pc_id }}-arrow)" marker-end="url(#{{ pc_id }}-arrow)"></line>
            <text class="pc-dim-text pc-label-h" text-anchor="end"></text>
          </g>
        </svg>
      </div>
      <div class="pc-switch" role="tablist">
        <button type="button" data-pc-tab="image" aria-selected="false">Afbeelding</button>
        <button type="button" data-pc-tab="preview" aria-selected="true">Afmetingen</button>
      </div>
    </div>

    <div class="pc-sidebar">
      <header class="pc-product-meta">
        <h1>{{ product.title }}</h1>
        <div class="pc-rating">★★★★★ <span>Concept productpagina</span></div>
        <div class="pc-base-price">{{ pc_variant.price | money }} <small>incl. btw</small></div>
        <button type="button" class="pc-sample">Bestel een sample</button>
      </header>

      <div class="pc-accordion">
        <details class="pc-accord" open>
          <summary><span class="pc-check">✓</span><span><strong>Afmetingen</strong><small data-pc-dimension-summary>Rechthoek: 10 cm × 10 cm</small></span><b>⌃</b></summary>
          <div class="pc-accord__body">
            <div class="pc-shape-tabs">
              <button type="button" class="pc-choice" data-shape="rectangle" aria-pressed="true"><svg viewBox="0 0 32 26"><rect x="3" y="5" width="26" height="16"/></svg>Rechthoek</button>
              <button type="button" class="pc-choice" data-pc-open-shapes aria-pressed="false"><svg viewBox="0 0 32 26"><path d="M5 19 L13 7 L20 17 L27 8"/></svg>Vormkiezer</button>
              <button type="button" class="pc-choice" data-pc-upload-trigger aria-pressed="false"><svg viewBox="0 0 32 26"><path d="M6 8h12l8 8v5H14l-8-8z"/><path d="M11 12h5"/></svg>Vorm upload</button>
              <input data-pc-upload type="file" accept="image/*" hidden>
            </div>
            <div class="pc-shape-picker" data-pc-shape-picker hidden>
              <button type="button" data-pc-shape-choice="rounded">Afgeronde rechthoek</button>
              <button type="button" data-pc-shape-choice="round">Cirkel</button>
              <button type="button" data-pc-shape-choice="triangle">Driehoek</button>
            </div>
            <p class="pc-upload-note" data-pc-upload-note hidden></p>
            <div class="pc-fields">
              <label>Breedte <small>Max: {{ pc_sheet_width | divided_by: 10 }} cm</small><span class="pc-unit"><input data-pc-width type="number" value="10" min="5" max="{{ pc_sheet_width | divided_by: 10 }}">cm</span></label>
              <label>Hoogte <small>Max: {{ pc_sheet_height | divided_by: 10 }} cm</small><span class="pc-unit"><input data-pc-height type="number" value="10" min="5" max="{{ pc_sheet_height | divided_by: 10 }}">cm</span></label>
            </div>
          </div>
        </details>

        <details class="pc-accord">
          <summary><span class="pc-check">✓</span><span><strong>Dikte</strong><small data-pc-thickness-summary>2 mm</small></span><b>⌄</b></summary>
          <div class="pc-accord__body">
            <p class="pc-picker-label">Bepaal de dikte (mm)</p>
            <div class="pc-thickness-grid" role="radiogroup">
              <button type="button" data-pc-thickness-choice="2" aria-pressed="true">2</button>
              <button type="button" data-pc-thickness-choice="3" aria-pressed="false">3</button>
              <button type="button" data-pc-thickness-choice="4" aria-pressed="false">4</button>
              <button type="button" data-pc-thickness-choice="5" aria-pressed="false">5</button>
              <button type="button" data-pc-thickness-choice="6" aria-pressed="false">6</button>
              <button type="button" data-pc-thickness-choice="8" aria-pressed="false">8</button>
              <button type="button" data-pc-thickness-choice="10" aria-pressed="false">10</button>
              <button type="button" data-pc-thickness-choice="13" aria-pressed="false">13</button>
              <button type="button" data-pc-thickness-choice="19" aria-pressed="false">19</button>
            </div>
            <select data-pc-thickness hidden><option value="2 mm">2 mm</option></select>
          </div>
        </details>

        <details class="pc-accord">
          <summary><span class="pc-empty"></span><span><strong>Boorgaten</strong></span><b>⌄</b></summary>
          <div class="pc-accord__body"><label class="pc-checkbox"><input type="checkbox" data-pc-holes> Boorgaten toevoegen</label><div class="pc-extra" data-pc-holes-extra><label>Aantal <input data-pc-holes-count type="number" value="4" min="1" max="8"></label><label>Diameter <input data-pc-hole-dia type="number" value="8" min="3"> mm</label></div></div>
        </details>

        <details class="pc-accord">
          <summary><span class="pc-empty"></span><span><strong>Uitsnede</strong></span><b>⌄</b></summary>
          <div class="pc-accord__body"><label class="pc-checkbox"><input type="checkbox" data-pc-cutout> Uitsnede toevoegen</label></div>
        </details>

        <details class="pc-accord" open>
          <summary><span class="pc-check">✓</span><span><strong>Randafwerking</strong><small>Gezaagd</small></span><b>⌃</b></summary>
          <div class="pc-accord__body pc-finish"><button type="button" class="pc-choice" data-finish="gezaagd" aria-pressed="true">Gezaagd <small>Gratis</small></button><button type="button" class="pc-choice" data-finish="gefreesd" aria-pressed="false">Gefreesd</button></div>
        </details>
      </div>

      <div class="pc-price-row"><span>Prijsopbouw</span><div><strong data-pc-price></strong><small data-pc-summary></small></div></div>
      <button class="pc-cart" data-pc-cart type="button">+ In winkelmand</button>
    </div>
  </div>
  <div class="pc-sticky-buy" aria-label="Besteloverzicht">
    <div class="pc-delivery"><strong>✓ Op voorraad</strong><span>Verwachte levering: 1–3 werkdagen</span></div>
    <div class="pc-sticky-price"><strong data-pc-price></strong><small data-pc-summary></small></div>
    <div class="pc-quantity" aria-label="Aantal"><button type="button">−</button><span>1</span><button type="button">+</button></div>
    <button class="pc-sticky-cart" type="button" data-pc-cart>+ In winkelmand</button>
  </div>
</section>
<script>
(function(){
  var root=document.getElementById({{ pc_id | json }}); if(!root) return;
  root.querySelectorAll('[data-pc-tab]').forEach(function(button){
    button.addEventListener('click',function(){
      var imageMode=button.getAttribute('data-pc-tab')==='image';
      var image=root.querySelector('.pc-image'), drawing=root.querySelector('.pc-svg'), canvas=root.querySelector('.pc-canvas');
      root.querySelectorAll('[data-pc-tab]').forEach(function(tab){tab.setAttribute('aria-selected','false')});
      button.setAttribute('aria-selected','true');
      if(image){image.hidden=!imageMode;image.style.display=imageMode?'block':'none'}
      if(drawing){drawing.hidden=imageMode;drawing.style.display=imageMode?'none':'block'}
      if(canvas) canvas.classList.toggle('is-image',imageMode);
    });
  });
})();
</script>