{% comment %} Rustige tweedelige homepage hero voor platen en maatwerk. {% endcomment %}
<section class="kxl-home-hero" aria-label="Kunststof platen en maatwerk">
  <div class="kxl-home-hero__grid">
    <a class="kxl-home-hero__card kxl-home-hero__card--primary" href="/collections/kunststof-platen">
      <img
        src="{{ 'kxl-home-custom-parts.svg' | asset_url }}"
        alt="Kunststof platen en maatwerkonderdelen"
        width="1440"
        height="810"
        loading="eager"
        fetchpriority="high"
      >
      <span class="kxl-home-hero__shade" aria-hidden="true"></span>
      <div class="kxl-home-hero__content">
        <span class="kxl-home-hero__eyebrow">Platen op maat</span>
        <h2>Kunststof voor ieder project</h2>
        <span class="kxl-home-hero__link">Bekijk materialen <i aria-hidden="true">→</i></span>
      </div>
    </a>

    <a class="kxl-home-hero__card kxl-home-hero__card--secondary" href="/pages/maatwerk">
      <img
        src="{{ 'kxl-home-machine-maatwerk.svg' | asset_url }}"
        alt="Kunststof maatwerkonderdelen gemonteerd op een machine"
        width="1200"
        height="1200"
        loading="eager"
      >
      <span class="kxl-home-hero__shade" aria-hidden="true"></span>
      <div class="kxl-home-hero__content">
        <span class="kxl-home-hero__eyebrow">Technisch maatwerk</span>
        <h3>Precies gemaakt voor jouw toepassing</h3>
        <span class="kxl-home-hero__link">Bekijk maatwerk <i aria-hidden="true">→</i></span>
      </div>
    </a>
  </div>
</section>

<style>
  .kxl-home-hero,.kxl-home-hero *{box-sizing:border-box}
  .kxl-home-hero{width:100%;max-width:1320px;margin:0 auto;padding:14px 20px 34px;font-family:inherit}
  .kxl-home-hero__grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.85fr);gap:16px}
  .kxl-home-hero__card{position:relative;min-width:0;min-height:450px;overflow:hidden;border-radius:8px;color:#fff;text-decoration:none;isolation:isolate}
  .kxl-home-hero__card>img{position:absolute;inset:0;z-index:-2;display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}
  .kxl-home-hero__card--primary>img{object-position:center}
  .kxl-home-hero__card--secondary>img{object-position:center 54%}
  .kxl-home-hero__shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(6,20,36,.02) 28%,rgba(8,29,55,.87) 100%)}
  .kxl-home-hero__card--secondary .kxl-home-hero__shade{background:linear-gradient(180deg,rgba(5,15,25,.04) 20%,rgba(6,25,48,.88) 100%)}
  .kxl-home-hero__content{position:absolute;right:0;bottom:0;left:0;padding:clamp(25px,3vw,40px)}
  .kxl-home-hero__card--primary .kxl-home-hero__content{max-width:720px}
  .kxl-home-hero__eyebrow{display:block;margin-bottom:9px;color:#8dd8f3;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .kxl-home-hero h2,.kxl-home-hero h3{margin:0;color:#fff;font-weight:780;letter-spacing:-.035em;line-height:1.04}
  .kxl-home-hero h2{max-width:650px;font-size:clamp(38px,4.1vw,57px)}
  .kxl-home-hero h3{max-width:390px;font-size:clamp(27px,2.5vw,38px)}
  .kxl-home-hero__link{display:inline-flex;align-items:center;gap:10px;margin-top:20px;padding-bottom:4px;border-bottom:1px solid rgba(255,255,255,.72);color:#fff;font-size:14px;font-weight:750}
  .kxl-home-hero__link i{font-size:18px;font-style:normal;transition:transform .2s ease}
  .kxl-home-hero__card:hover>img{transform:scale(1.025)}
  .kxl-home-hero__card:hover .kxl-home-hero__link i{transform:translateX(4px)}
  @media(max-width:900px){
    .kxl-home-hero{padding-inline:18px}
    .kxl-home-hero__grid{grid-template-columns:1fr;gap:12px}
    .kxl-home-hero__card{min-height:420px}
    .kxl-home-hero__card--secondary{min-height:330px}
    .kxl-home-hero__card--secondary>img{object-position:center 52%}
    .kxl-home-hero__card--secondary h3{max-width:520px}
  }
  @media(max-width:600px){
    .kxl-home-hero{padding:8px 14px 26px}
    .kxl-home-hero__card{min-height:390px}
    .kxl-home-hero__card--secondary{min-height:310px}
    .kxl-home-hero__content{padding:23px}
    .kxl-home-hero h2{font-size:37px}
    .kxl-home-hero h3{font-size:29px}
  }
</style>